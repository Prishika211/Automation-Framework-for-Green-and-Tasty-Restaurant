<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UI Test Suite">
    <listeners>
        <listener class-name="com.epam.greenandtasty.listeners.UITestExecutionListener"/>
    </listeners>
    <test verbose="2" parallel="methods" thread-count="4" name="UI Tests">
        <classes>
            <class name="com.epam.greenandtasty.runners.ui.UITestRunner"/>
        </classes>
    </test>
</suite>